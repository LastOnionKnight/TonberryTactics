<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);external\**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.6.1.0</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <InformationalVersion>1.6.1</InformationalVersion>
    <Authors>LastOnionKnight</Authors>
    <Description>Tonberry Tactics web companion for the GearGoblin Dalamud plugin. Parses GG-EXPORT v1/v2 payloads, displays imported gear and stats, runs the shared GearGoblin.Core meld optimizer, and emits GG-PLAN:v1 recommendations for /ttimport.</Description>
    <RepositoryUrl>https://github.com/LastOnionKnight/TonberryTactics</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="external\GearGoblin.Core\GearGoblin.Core.csproj" />
  </ItemGroup>

</Project>
